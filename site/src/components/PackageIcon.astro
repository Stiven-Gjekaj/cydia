---
import type { Package } from "../lib/packages";
import { packageIcon } from "../lib/repo";
import { url } from "../lib/url";

interface Props {
  pkg: Package;
  size?: number;
}

const { pkg, size = 64 } = Astro.props;
const hasIcon = packageIcon(pkg) !== null;
---

{
  hasIcon ? (
    <img
      src={url(`icons/${pkg.id}.png`)}
      width={size}
      height={size}
      alt=""
      class="shrink-0 rounded-[22%] shadow-sm"
      style={`width:${size}px;height:${size}px`}
    />
  ) : (
    <div
      class="flex shrink-0 items-center justify-center rounded-[22%] bg-base-300 font-bold"
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
    >
      {pkg.name.slice(0, 1)}
    </div>
  )
}
