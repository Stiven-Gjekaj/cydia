---
import Layout from "../layouts/Layout.astro";
import { formatSize, summary } from "../lib/packages";
import { ADD_LINKS, SOURCE_URL, loadPackages, packageIcon } from "../lib/repo";
import { url } from "../lib/url";

const packages = loadPackages();
---

<Layout title="Stiven's Cydia">
  <h1>Jailbreak apps for old iPhones</h1>
  <p class="lead">
    Native apps and demakes for iOS 6 and later. Add the source one time, and each app gets its updates from it.
  </p>

  <section id="add" class="box">
    <div class="url-row">
      <code class="url" id="source-url">{SOURCE_URL}</code>
      <button class="button" id="copy" type="button">Copy</button>
    </div>
    <div class="buttons">
      <a class="button primary" href={ADD_LINKS.cydia}>Add to Cydia</a>
      <a class="button" href={ADD_LINKS.sileo}>Add to Sileo</a>
      <a class="button" href={ADD_LINKS.zebra}>Add to Zebra</a>
    </div>
  </section>

  <h2 id="apps">Apps</h2>
  <div class="apps">
    {
      packages.map((pkg) => {
        const newest = pkg.versions[0];
        return (
          <a class="box app-card" href={url(`apps/${pkg.id}/`)}>
            {packageIcon(pkg) && <img src={url(`icons/${pkg.id}.png`)} alt="" />}
            <div>
              <h3>{pkg.name}</h3>
              <p class="muted">{summary(pkg.description)}</p>
              <p class="muted">
                Version {newest.version}, {formatSize(newest.size)}
              </p>
            </div>
          </a>
        );
      })
    }
  </div>

  <h2>How to add the source</h2>
  <ol class="steps">
    <li>Open Cydia, Sileo, or Zebra on a jailbroken iPhone or iPad with iOS 7 or later.</li>
    <li>Tap "Add to Cydia", "Add to Sileo", or "Add to Zebra" above on the device. Or open Sources, tap Edit, then Add, and paste the address.</li>
    <li>Open the source, choose an app, and tap Install.</li>
  </ol>
  <p class="muted">With APT, put this line in a file in <code>/etc/apt/sources.list.d/</code>:</p>
  <pre class="box"><code>deb {SOURCE_URL} ./</code></pre>

  <h2>On iOS 6</h2>
  <div class="box note">
    <strong>Cydia on iOS 6 cannot read this source.</strong>
    <span class="muted">
      GitHub Pages accepts only TLS 1.2, and the APT of iOS 6 stops at TLS 1.0.
      Install each app from its <code>.deb</code> file instead.
    </span>
  </div>
  <ol class="steps">
    <li>Open the page of the app and download the <code>.deb</code> file.</li>
    <li>Copy the file to the device, for example with SSH.</li>
    <li>As root, run <code>dpkg -i</code> with the file, then run <code>su mobile -c uicache</code>.</li>
  </ol>

  <script>
    const button = document.getElementById("copy");
    const text = document.getElementById("source-url")?.textContent ?? "";
    button?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
  </script>
</Layout>
