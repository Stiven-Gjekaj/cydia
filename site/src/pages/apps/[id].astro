---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { formatSize, summary, type Package } from "../../lib/packages";
import { ADD_LINKS, loadPackages, packageIcon } from "../../lib/repo";
import { url } from "../../lib/url";

export const getStaticPaths = (() =>
  loadPackages().map((pkg) => ({ params: { id: pkg.id }, props: { pkg } }))) satisfies GetStaticPaths;

const { pkg } = Astro.props as { pkg: Package };
const newest = pkg.versions[0];
const debName = newest.filename.split("/").pop();
---

<Layout title={pkg.name} description={summary(pkg.description)}>
  <div class="app-head">
    {packageIcon(pkg) && <img src={url(`icons/${pkg.id}.png`)} alt="" />}
    <div>
      <h1>{pkg.name}</h1>
      <div class="muted">{[pkg.section, pkg.author && `By ${pkg.author}`].filter(Boolean).join(", ")}</div>
    </div>
  </div>

  <div class="buttons">
    <a class="button primary" href={ADD_LINKS.cydia}>Add the source to Cydia</a>
    <a class="button" href={url(newest.filename)} download>Download the .deb</a>
    {pkg.homepage && <a class="button" href={pkg.homepage}>Source code</a>}
  </div>

  <div class="facts">
    <div class="box"><span class="muted">Version</span><span>{newest.version}</span></div>
    <div class="box"><span class="muted">Size</span><span>{formatSize(newest.size)}</span></div>
    <div class="box"><span class="muted">Needs</span><span>{pkg.minIOS ? `iOS ${pkg.minIOS} or newer` : "Any iOS"}</span></div>
    <div class="box"><span class="muted">Package</span><span class="mono">{pkg.id}</span></div>
  </div>

  {pkg.description.split(/\n\n+/).map((paragraph) => <p>{paragraph}</p>)}

  <h2>Install</h2>
  <p>On iOS 7 and later, add the source, then find {pkg.name} in it. With APT:</p>
  <pre class="box"><code>apt-get install {pkg.id}</code></pre>
  <p>On iOS 6, Cydia cannot read the source. Download the <code>.deb</code> file, copy it to the device, and run as root:</p>
  <pre class="box"><code>dpkg -i {debName}
su mobile -c uicache</code></pre>

  <h2>Versions</h2>
  {
    pkg.versions.map((v, i) => (
      <section class="box version">
        <div class="version-head">
          <h3>{v.version}{i === 0 && <span class="muted"> (latest)</span>}</h3>
          <a href={url(v.filename)} download>Download</a>
        </div>
        <div class="muted">{formatSize(v.size)}</div>
        {v.sha256 && <div class="muted mono">SHA-256 {v.sha256}</div>}
      </section>
    ))
  }
</Layout>
