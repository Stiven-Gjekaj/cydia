---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/url";
---

<Layout title="Page not found - Stiven Gjekaj Cydia Repository">
  <section class="hero py-24">
    <div class="hero-content flex-col text-center">
      <h1 class="text-5xl font-extrabold">404</h1>
      <p class="text-lg text-base-content/75">This page is not in the repository.</p>
      <a href={url()} class="btn btn-primary">Go to the home page</a>
    </div>
  </section>
</Layout>
