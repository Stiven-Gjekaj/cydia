---
import "../styles/global.css";
import { GITHUB_URL } from "../lib/repo";
import { url } from "../lib/url";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Apps for old iPhones on a jailbreak, by Stiven Gjekaj." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={url("CydiaIcon.png")} />
    <link rel="apple-touch-icon" href={url("CydiaIcon.png")} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <img src={url("CydiaIcon.png")} alt="" />
        <a href={url()}>Stiven Gjekaj Cydia</a>
        <nav>
          <a href={url("#apps")}>Apps</a>
          <a class="wide" href={url("#add")}>Add the source</a>
          <a href={GITHUB_URL}>GitHub</a>
        </nav>
      </header>
      <slot />
      <footer>
        The apps are for jailbroken devices. Each version of each package stays in the repository.
        The Karla font is under the SIL Open Font License.
        The Cydia icon is by Jay Freeman (saurik), under the GNU GPL version 3.
      </footer>
    </div>
  </body>
</html>
